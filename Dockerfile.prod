FROM node:22-alpine AS builder

WORKDIR /app

# pnpm-workspace.yaml carries the allowBuilds approvals; without it pnpm 11
# aborts install/run with ERR_PNPM_IGNORED_BUILDS.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

RUN npm install -g pnpm@11.9.0 && pnpm install --frozen-lockfile

COPY . .

RUN npx prisma generate

RUN pnpm run build

FROM node:22-alpine AS production

WORKDIR /app

ENV NODE_ENV=production

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Install production dependencies AND the Prisma CLI (needed at runtime for
# `prisma migrate deploy` and `prisma generate`). Pin the CLI to the same
# version as @prisma/client so they never drift at build time.
RUN npm install -g pnpm@11.9.0 && \
    pnpm install --frozen-lockfile --prod && \
    pnpm add prisma@6.19.3

# Copy built application, Prisma schema and the compiled seed (seed.js + data/)
COPY --from=builder /app/dist/src ./dist
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/dist/prisma ./prisma

# Generate Prisma client in production (ensures compatibility)
RUN npx prisma generate

# Run as the unprivileged node user instead of root
USER node

EXPOSE 3000

#CMD ["sh", "-c", "npx prisma migrate deploy && node prisma/seed && node dist/main"]
CMD ["node", "dist/main"]
