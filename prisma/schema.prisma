generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int                      @id @default(autoincrement())
  userType                UserType                 @default(REGULAR)
  email                   String                   @unique
  password                String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  lastLoginAt             DateTime?
  refreshToken            String?
  isEmailConfirmed        Boolean                  @default(false)
  isActive                Boolean                  @default(true)
  demoExpiresAt           DateTime?
  workouts                Workout[]
  workoutTemplates        WorkoutTemplate[]
  exercises               Exercise[]
  exerciseFavorites       ExerciseFavorite[]
  personalRecords         PersonalRecord[]
  emailConfirmationTokens EmailConfirmationToken[]
  passwordResetTokens     PasswordResetToken[]
  bodyMeasurements        BodyMeasurement[]
  profile                 UserProfile?
  programs                Program[]
  programEnrollments      ProgramEnrollment[]
}

model UserProfile {
  id            Int            @id @default(autoincrement())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int            @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  heightCm      Float?
  birthDate     DateTime?      @db.Date
  sex           Sex?
  activityLevel ActivityLevel?
  goalWeight    Float?
  weightGoal    WeightGoal?
}

model DeletedUser {
  id             Int      @id @default(autoincrement())
  originalUserId Int
  email          String
  createdAt      DateTime
  deletedAt      DateTime @default(now())
}

model EmailConfirmationToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  isUsed    Boolean   @default(false)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int

  @@index([token])
  @@index([userId, isUsed])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  isUsed    Boolean   @default(false)
  ipAddress String?
  userAgent String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int

  @@index([token])
  @@index([userId, isUsed])
}

model Exercise {
  id                       Int                       @id @default(autoincrement())
  name                     String
  user                     User?                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                   Int?
  category                 String                    @default("strength") // strength cardio flexibility sports yoga etc..
  targetMuscleGroups       String[]                  @default([])
  secondaryMuscleGroups    String[]                  @default([])
  equipment                String
  // level String?      beginner intermediate expert
  // mechanic String?   compound isolation
  // force String?      push pull 
  instructions             String?
  imageUrls                String[]                  @default([])
  videoUrls                String[]                  @default([])
  workoutExercises         WorkoutExercise[]
  workoutTemplateExercises WorkoutTemplateExercise[]
  favorites                ExerciseFavorite[]
  personalRecords          PersonalRecord[]
  programExercises         ProgramExercise[]

  @@unique([name, userId, equipment])
}

model ExerciseFavorite {
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  exerciseId Int
  createdAt  DateTime @default(now())

  @@id([userId, exerciseId])
  @@index([exerciseId])
}

model Workout {
  id                 Int                      @id @default(autoincrement())
  title              String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  startedAt          DateTime                 @default(now())
  completedAt        DateTime?
  activeDuration     Float                    @default(0)
  status             WorkoutStatus            @default(DRAFT)
  notes              String?
  isPaused           Boolean                  @default(false)
  pauseDuration      Float                    @default(0)
  lastPauseStartTime DateTime?
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             Int
  workoutExercises   WorkoutExercise[]
  // Set when the workout was generated from a program day. The log (and the
  // enrollment behind it) outlives the workout; deleting a workout only
  // detaches it.
  programDayLog      ProgramEnrollmentDayLog? @relation(fields: [programDayLogId], references: [id], onDelete: SetNull)
  programDayLogId    Int?                     @unique

  @@index([userId, status, startedAt])
}

model WorkoutExercise {
  id                        Int               @id @default(autoincrement())
  workout                   Workout           @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  workoutId                 Int
  exercise                  Exercise          @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  exerciseId                Int
  exerciseOrder             Int
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  notes                     String?
  workoutSets               WorkoutSet[]
  previousWorkoutExercise   WorkoutExercise?  @relation("PreviousWorkoutExercise", fields: [previousWorkoutExerciseId], references: [id])
  previousWorkoutExerciseId Int?
  nextWorkoutExercise       WorkoutExercise[] @relation("PreviousWorkoutExercise")
  // Program slot this exercise was generated for. Survives exercise swaps so
  // progress can be followed per slot across an enrollment.
  progressionKey            String?

  @@index([workoutId])
  @@index([exerciseId])
}

model WorkoutSet {
  id                   Int              @id @default(autoincrement())
  workoutExercise      WorkoutExercise  @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  workoutExerciseId    Int
  setNumber            Int
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  completed            Boolean          @default(false)
  notes                String?
  type                 String           @default("normal")
  reps                 Int?
  weight               Float?
  duration             Int?
  // Target values carried over when the workout was started from a template.
  // Surfaced as input placeholders; adopted as the real values when a set is
  // completed untouched. Written only at from-template creation, never patched.
  suggestedReps        Int?
  suggestedWeight      Float?
  suggestedDuration    Int?
  // Rating of perceived exertion logged by the user (6-10 in 0.5 steps).
  rpe                  Float?
  // Program prescription carried over when the workout was started from a
  // program day. programSetId is the set's id inside the enrollment snapshot;
  // null means the user added the set themselves and the progression engine
  // ignores it.
  programSetId         Int?
  suggestedRepsMax     Int?
  suggestedRpe         Float?
  suggestedRestSeconds Int?
  suggestedAmrap       Boolean          @default(false)
  personalRecords      PersonalRecord[]

  @@index([workoutExerciseId])
}

model WorkoutTemplate {
  id                       Int                       @id @default(autoincrement())
  name                     String
  notes                    String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                   Int
  workoutTemplateExercises WorkoutTemplateExercise[]

  @@index([userId])
}

model WorkoutTemplateExercise {
  id                  Int                  @id @default(autoincrement())
  workoutTemplate     WorkoutTemplate      @relation(fields: [workoutTemplateId], references: [id], onDelete: Cascade)
  workoutTemplateId   Int
  exercise            Exercise             @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  exerciseId          Int
  exerciseOrder       Int
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  notes               String?
  workoutTemplateSets WorkoutTemplateSet[]

  @@index([workoutTemplateId])
  @@index([exerciseId])
}

model WorkoutTemplateSet {
  id                        Int                     @id @default(autoincrement())
  workoutTemplateExercise   WorkoutTemplateExercise @relation(fields: [workoutTemplateExerciseId], references: [id], onDelete: Cascade)
  workoutTemplateExerciseId Int
  setNumber                 Int
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  notes                     String?
  type                      String                  @default("normal")
  reps                      Int?
  weight                    Float?
  duration                  Int?

  @@index([workoutTemplateExerciseId])
}

model PersonalRecord {
  id           Int        @id @default(autoincrement())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  exercise     Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  exerciseId   Int
  recordType   RecordType
  value        Float
  achievedAt   DateTime
  createdAt    DateTime   @default(now())
  workoutSet   WorkoutSet @relation(fields: [workoutSetId], references: [id], onDelete: Cascade)
  workoutSetId Int

  @@unique([userId, exerciseId, recordType])
  @@index([workoutSetId])
}

model DemoIpTracking {
  id        Int      @id @default(autoincrement())
  ipAddress String
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
}

model BodyMeasurement {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  createdAt  DateTime @default(now())
  measuredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  weight     Float?
  fatPercent Float?
  notes      String?
  imageUrl   String?
  neckCm     Float?
  chestCm    Float?
  waistCm    Float?
  hipsCm     Float?
  armCm      Float?
  thighCm    Float?
  calfCm     Float?

  @@index([userId, measuredAt])
}

enum UserType {
  REGULAR
  DEMO
  SYSTEM
}

enum WorkoutStatus {
  ACTIVE
  DRAFT
  COMPLETED
}

enum RecordType {
  MAX_WEIGHT
  ONE_REP_MAX
  MAX_SET_VOLUME
}

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum WeightGoal {
  LOSE
  MAINTAIN
  GAIN
}

// ---------------------------------------------------------------------------
// Workout programs
//
// A Program describes ONE training cycle: blocks of weeks, each block holding
// the weekly structure once (days -> exercises -> sets). Week rows carry only
// per-week metadata (deload flag, multipliers); set rows may be scoped to a
// week-in-block for schemes that change week to week (5/3/1 percentages).
// Progression is a strategy enum plus JSON params evaluated by the pure engine
// in src/programs/engine. Enrollments keep an immutable JSON snapshot of the
// program so authoring changes never disturb a running program.
// ---------------------------------------------------------------------------

model Program {
  id           Int                 @id @default(autoincrement())
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  // Seed identity for curated programs (system user); null for user programs.
  slug         String?
  version      Int                 @default(1)
  name         String
  description  String?
  // Attribution for curated programs, e.g. "Inspired by ...".
  credit       String?
  goal         ProgramGoal
  level        ProgramLevel
  scheduleMode ProgramScheduleMode @default(SEQUENCE)
  durationMode ProgramDurationMode @default(FIXED)
  daysPerWeek  Int
  effortScale  EffortScale         @default(RPE)
  visibility   ProgramVisibility   @default(PRIVATE)
  // Reserved for share-by-link; unused until sharing ships.
  shareToken   String?             @unique
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  blocks       ProgramBlock[]
  enrollments  ProgramEnrollment[]

  @@unique([userId, slug])
  @@index([userId, updatedAt])
  @@index([visibility, level, goal, daysPerWeek])
}

model ProgramBlock {
  id         Int           @id @default(autoincrement())
  program    Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId  Int
  blockOrder Int
  name       String
  focus      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  weeks      ProgramWeek[]
  days       ProgramDay[]

  @@index([programId])
}

model ProgramWeek {
  id                  Int          @id @default(autoincrement())
  block               ProgramBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  blockId             Int
  weekInBlock         Int
  label               String?
  isDeload            Boolean      @default(false)
  volumeMultiplier    Float        @default(1)
  intensityMultiplier Float        @default(1)

  @@unique([blockId, weekInBlock])
}

model ProgramDay {
  id        Int               @id @default(autoincrement())
  block     ProgramBlock      @relation(fields: [blockId], references: [id], onDelete: Cascade)
  blockId   Int
  dayOrder  Int
  name      String
  // 1 = Monday ... 7 = Sunday. Only meaningful for CALENDAR programs.
  weekday   Int?
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  exercises ProgramExercise[]

  @@index([blockId])
}

model ProgramExercise {
  id             Int                 @id @default(autoincrement())
  day            ProgramDay          @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId          Int
  exercise       Exercise            @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  exerciseId     Int
  exerciseOrder  Int
  // Slots sharing a key share one progression state (e.g. 5/3/1 main work and
  // its supplemental sets, or the same lift on several days).
  progressionKey String
  strategy       ProgressionStrategy @default(NONE)
  // Strategy parameters; shape depends on `strategy` (see engine DTOs).
  progression    Json?
  roundingKg     Float?
  restSeconds    Int?
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  sets           ProgramSet[]

  @@index([dayId])
  @@index([exerciseId])
}

model ProgramSet {
  id                Int             @id @default(autoincrement())
  programExercise   ProgramExercise @relation(fields: [programExerciseId], references: [id], onDelete: Cascade)
  programExerciseId Int
  // null = applies to every week of the block; a number scopes the row to that
  // week (the engine uses week-scoped rows when any exist for the week).
  weekInBlock       Int?
  setOrder          Int
  type              String          @default("normal")
  repsMin           Int?
  repsMax           Int?
  isAmrap           Boolean         @default(false)
  // Percentage of the strategy's load basis (training max / working weight).
  percent           Float?
  // Fixed load in kg (NONE strategy with a FIXED basis).
  weight            Float?
  // Target effort; RIR is derived as 10 - RPE for display.
  targetRpe         Float?
  restSeconds       Int?
  duration          Int?
  notes             String?

  @@index([programExerciseId])
}

model ProgramEnrollment {
  id               Int                              @id @default(autoincrement())
  user             User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           Int
  // The snapshot is authoritative; the program link is informational and is
  // cleared (not cascaded) when the program is deleted.
  program          Program?                         @relation(fields: [programId], references: [id], onDelete: SetNull)
  programId        Int?
  programVersion   Int
  programName      String
  totalWeeks       Int
  status           EnrollmentStatus                 @default(ACTIVE)
  // Serialized program tree (blocks -> weeks -> days -> exercises -> sets).
  snapshot         Json
  // CALENDAR programs: the Monday of cycle 1, week 1.
  startDate        DateTime                         @db.Date
  // CALENDAR programs: optional per-enrollment weekday override { dayId: 1..7 }.
  weekdayMap       Json?
  currentCycle     Int                              @default(1)
  currentWeekIndex Int                              @default(1)
  currentDayIndex  Int                              @default(1)
  completedAt      DateTime?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt
  states           ProgramEnrollmentExerciseState[]
  dayLogs          ProgramEnrollmentDayLog[]

  @@index([userId, status])
  @@index([programId])
}

// One row per progression key. Exercise ids are plain columns (no FK) so an
// enrollment survives the deletion of a custom exercise; the start flow asks
// the user to swap a missing exercise instead.
model ProgramEnrollmentExerciseState {
  id                 Int               @id @default(autoincrement())
  enrollment         ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId       Int
  progressionKey     String
  exerciseId         Int
  originalExerciseId Int
  workingWeight      Float?
  trainingMax        Float?
  e1rm               Float?
  stageIndex         Int               @default(0)
  consecutiveFails   Int               @default(0)
  // Reps-only double progression (bodyweight work): added to the rows' range.
  repsOffset         Int               @default(0)
  roundingKg         Float?
  updatedAt          DateTime          @updatedAt

  @@unique([enrollmentId, progressionKey])
}

model ProgramEnrollmentDayLog {
  id           Int                 @id @default(autoincrement())
  enrollment   ProgramEnrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId Int
  cycle        Int
  weekIndex    Int
  dayIndex     Int
  // Id of the day inside the enrollment snapshot.
  programDayId Int
  dayName      String
  status       ProgramDayLogStatus
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  workout      Workout?

  @@unique([enrollmentId, cycle, weekIndex, dayIndex])
}

enum ProgramGoal {
  STRENGTH
  HYPERTROPHY
  GENERAL_FITNESS
  POWERLIFTING
  ENDURANCE
  ATHLETIC
}

enum ProgramLevel {
  BEGINNER
  NOVICE
  INTERMEDIATE
  ADVANCED
  ELITE
}

enum ProgramScheduleMode {
  SEQUENCE
  CALENDAR
}

enum ProgramDurationMode {
  FIXED
  OPEN_ENDED
}

enum ProgramVisibility {
  PRIVATE
  SYSTEM
}

enum EffortScale {
  RPE
  RIR
}

enum ProgressionStrategy {
  NONE
  LINEAR
  DOUBLE
  PERCENT_TM
  RPE
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum ProgramDayLogStatus {
  STARTED
  COMPLETED
  SKIPPED
}
