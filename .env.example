NODE_ENV=development              # development | production (production hardens CORS, cookies, disables Swagger)
DATABASE_URL=                     # required for production, optional for dev (docker compose uses a default)
PORT=3000                         # optional
JWT_SECRET=changeme               # required
JWT_EXP=15m                       # optional
JWT_REFRESH_EXP=30d               # optional
CORS_ORIGIN=                      # required in production (comma-separated allowed origins), optional for dev
FRONTEND_URL=                     # required in production (used in emails)
SENDGRID_API_KEY=                 # optional (falls back to a console mock when unset)
SENDGRID_VERIFIED_SENDER_EMAIL=   # required in production
RECAPTCHA_SECRET=                 # required in production (demo-session captcha verification)
